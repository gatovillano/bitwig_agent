{
    "auto_approve": true,
    "mcpServers": {
        "filesystem": {
            "command": "/usr/bin/npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "/home/gato/Proyectos"
            ],
            "transport": "stdio",
            "env": {
                "DISPLAY": ":1",
                "WAYLAND_DISPLAY": "wayland-1",
                "XDG_RUNTIME_DIR": "/run/user/1000",
                "DBUS_SESSION_BUS_ADDRESS": "unix:path=/run/user/1000/bus",
                "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin:/home/gato/.local/bin:/home/gato/.cargo/bin",
                "npm_config_yes": "true"
            }
        },
        "git": {
            "command": "/home/gato/.local/bin/uvx",
            "args": [
                "mcp-server-git"
            ],
            "transport": "stdio",
            "env": {
                "DISPLAY": ":1",
                "WAYLAND_DISPLAY": "wayland-1",
                "XDG_RUNTIME_DIR": "/run/user/1000",
                "DBUS_SESSION_BUS_ADDRESS": "unix:path=/run/user/1000/bus",
                "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin:/home/gato/.local/bin:/home/gato/.cargo/bin"
            }
        }
    },
    "default_model": "inception/mercury-3"
}