# Bitwig Agent - Environment Variables Example

# LLM API Keys (configured via /keys in CLI or directly here)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# Default Model Selection (optional, can be overridden with --model or /model)
BITWIG_LLM_MODEL=gemini/gemini-2.5-flash

# Bitwig Bridge HTTP Configuration (default: http://127.0.0.1:8989)
BITWIG_BRIDGE_URL=http://127.0.0.1:8989
